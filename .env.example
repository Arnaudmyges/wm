# Copier en .env (chmod 600) et remplir. Ne jamais committer .env.

# En-tête Cookie du site (au minimum sb-<ref>-auth-token.0 et .1), copié juste après un F5
WM_COOKIE=""

# Clé anon Supabase (en-tête apikey des requêtes /rest/v1/)
SUPABASE_APIKEY=""

# Optionnel : déduit du cookie sinon (https://<ref>.supabase.co)
# SUPABASE_URL=""
