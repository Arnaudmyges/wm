# Copier en .env et remplir (voir README.md, section « Configuration »).
# Ne jamais committer ni partager .env : il donne accès à ton compte.

# En-tête Cookie du site, copié depuis une fenêtre privée réservée au script
WM_COOKIE=""

# Clé publique Supabase du site (en-tête apikey des requêtes vers supabase.co)
SUPABASE_APIKEY=""

# Optionnel : déduit du cookie sinon (https://<ref>.supabase.co)
# SUPABASE_URL=""

# Optionnel : notifications (--notify), voir README.md
# NTFY_SERVER="https://ntfy.sh"
# NTFY_TOPIC=""
# NTFY_TOKEN=""
# DISCORD_WEBHOOK_URL=""

# Optionnel : dossier des fichiers créés (session, cache, rapports), par défaut celui des scripts
# WM_DATA_DIR=""
